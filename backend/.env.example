# ==============================================================================
# Veridex Backend Environment Configuration (.env.example)
# ==============================================================================

PROJECT_NAME="Veridex"
SECRET_KEY="super-secret-jwt-key-for-fake-review-detection-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Dedicated Admin Email (Only this account has administrative privileges)
ADMIN_EMAIL="namithaaa444@gmail.com"

# Database Configuration (Defaults to SQLite if MySQL is unreachable)
MYSQL_USER="root"
MYSQL_PASSWORD="password"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DB="fake_review_db"

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION
# ------------------------------------------------------------------------------
# Option 1: Gmail SMTP (Use Google App Password, NOT standard account password)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"
SMTP_FROM_EMAIL="your-email@gmail.com"
SMTP_FROM_NAME="Veridex Security"
SMTP_USE_SSL=false

# ------------------------------------------------------------------------------
# Option 2: Resend API (https://resend.com)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
