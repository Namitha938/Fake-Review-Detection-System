# Backend Configuration
PROJECT_NAME="Fake Review Detection System"
SECRET_KEY="super-secret-jwt-key-for-fake-review-detection-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (MySQL 8)
# In Docker: mysql+pymysql://user:password@db:3306/fake_review_db
# In local dev: sqlite:///./fake_reviews.db (auto-fallback if MySQL is not running)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fake_review_db

MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=fake_review_db

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1

